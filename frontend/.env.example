# Copy this file to `.env.local` to override settings when running `npm run dev` on your machine.
# Vite only exposes variables prefixed with VITE_ to browser code (via import.meta.env).

# true  -> every API function returns data from the in-memory mock store (src/mocks/mockStore.ts).
#          No backend needed. Good for working on the UI.
# false -> API functions run YOUR fetch code against the C# backend through the /api proxy.
VITE_USE_MOCKS=true

# Where the Vite dev server forwards /api requests (read by vite.config.ts, not by browser code).
API_PROXY_TARGET=http://localhost:5080
